---
// The complete homepage. Used by src/pages/index.astro (German) and
// src/pages/en/index.astro (English) so both languages share one layout.
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import About from './About.astro';
import Services from './Services.astro';
import Process from './Process.astro';
import Why from './Why.astro';
import Pricing from './Pricing.astro';
import Contact from './Contact.astro';
import { useT, alternatesFor, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={alternatesFor('home')} home>
  <Hero lang={lang} />
  <Projects lang={lang} />
  <About lang={lang} />
  <Services lang={lang} />
  <Process lang={lang} />
  <Why lang={lang} />
  <Pricing lang={lang} />
  <Contact lang={lang} />
</Base>
