---
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang);
const groups = (['new', 'existing'] as const).map((key) => ({
  label: t.services.groups[key],
  items: t.services.items.filter((item) => item.group === key),
}));
let counter = 0;
---

<section class="section services" id="services">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.services.eyebrow}</p>
      <h2 class="section-title">{t.services.title}</h2>
      <p class="lead">{t.services.lead}</p>
    </header>

    {
      groups.map((group) => (
        <div class="group reveal">
          <h3 class="group__label">{group.label}</h3>
          <ul class="group__list">
            {group.items.map((item) => (
              <li class="service">
                <span class="service__num" aria-hidden="true">
                  {String(++counter).padStart(2, '0')}
                </span>
                <h4 class="service__name">{item.name}</h4>
                <p class="service__text">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <p class="more reveal">
      <a class="arrow-link" href="#pricing">{t.services.pricingLink}</a>
    </p>
  </div>
</section>

<style>
  .services {
    background: linear-gradient(to bottom, transparent, rgba(124, 58, 237, 0.06) 50%, transparent);
  }

  .group {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-strong);
  }

  .group + .group {
    margin-top: 2.25rem;
  }

  .group__label {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .service {
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.8fr) minmax(0, 1.4fr);
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    transition: padding-left 0.4s var(--ease);
  }

  .service:first-child {
    padding-top: 0;
  }

  .service:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .service:hover {
    padding-left: 0.5rem;
  }

  .service__num {
    color: var(--teal);
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .service__name {
    margin: 0;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .service__text {
    color: var(--muted);
  }

  .more {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 960px) {
    .group {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .service {
      grid-template-columns: 2.5rem 1fr;
    }

    .service__text {
      grid-column: 2;
    }
  }
</style>
