---
// Layout for text pages: legal pages and the form confirmation page.
import Base from '../layouts/Base.astro';
import { useT, routes, alternatesFor, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  /** Shows the "draft" banner used while legal pages still contain placeholders. */
  draft?: boolean;
}

const { lang, route, title, draft = false } = Astro.props;
const t = useT(lang);
---

<Base
  lang={lang}
  title={`${title} – Forma Studio`}
  description={title}
  alternates={alternatesFor(route)}
  noindex
>
  <article class="page container">
    {draft && <p class="draft">{t.legal.draft}</p>}
    <h1>{title}</h1>
    <div class="prose">
      <slot />
    </div>
    <a class="btn btn--ghost" href={routes[lang].home}>{t.legal.back}</a>
  </article>
</Base>

<style>
  .page {
    max-width: 46rem;
    padding-block: calc(var(--header-h) + 5rem) var(--section);
  }

  h1 {
    margin-bottom: 2.5rem;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    hyphens: auto;
  }

  /* Long single-word titles such as "Datenschutzerklärung" must fit on
     narrow phones. */
  @media (max-width: 520px) {
    h1 {
      font-size: clamp(1.5rem, 7vw, 2.25rem);
      overflow-wrap: anywhere;
    }
  }

  .draft {
    margin-bottom: 2rem;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--accent);
    border-radius: var(--radius-s);
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .prose {
    display: grid;
    gap: 1rem;
    margin-bottom: 3rem;
    color: #d3d3da;
  }

  .prose :global(h2) {
    margin-top: 1.75rem;
    color: var(--text);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .prose :global(ul) {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .prose :global(mark) {
    padding: 0.1em 0.4em;
    border-radius: 4px;
    background: rgba(228, 255, 0, 0.16);
    color: var(--accent);
    font-weight: 500;
  }
</style>
