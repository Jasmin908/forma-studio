---
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang);
---

<section class="section" id="process">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.process.eyebrow}</p>
      <h2 class="section-title">{t.process.title}</h2>
      <p class="lead">{t.process.lead}</p>
    </header>

    <ol class="steps">
      {
        t.process.steps.map((step, i) => (
          <li class="step reveal" style={`--i:${i}`}>
            <span class="step__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 2.25rem;
  }

  /* Timeline: a line with a marker per step. */
  .step::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    left: 0;
    right: -1.5rem;
    height: 1px;
    background: var(--line-strong);
  }

  .step:last-child::before {
    right: 0;
    background: linear-gradient(to right, var(--line-strong), transparent);
  }

  .step::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(228, 255, 0, 0.14);
  }

  .step__num {
    color: var(--muted);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    font-size: 1.375rem;
    letter-spacing: -0.025em;
  }

  .step p {
    color: var(--muted);
    font-size: 0.9875rem;
  }

  @media (max-width: 1020px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 0;
      max-width: 36rem;
    }

    .step {
      grid-template-columns: 4.5rem 1fr;
      gap: 0.35rem 1rem;
      padding: 0 0 2.5rem 2.25rem;
    }

    .step:last-child {
      padding-bottom: 0;
    }

    .step::before {
      top: 0.5rem;
      bottom: -0.5rem;
      left: 0.32rem;
      right: auto;
      width: 1px;
      height: auto;
    }

    .step:last-child::before {
      background: linear-gradient(to bottom, var(--line-strong), transparent);
    }

    .step::after {
      top: 0.5rem;
    }

    .step__num {
      grid-row: span 2;
      font-size: 2.25rem;
    }

    .step p {
      grid-column: 2;
    }
  }
</style>
