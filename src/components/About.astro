---
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang);
---

<section class="section" id="about">
  <div class="container about">
    <div class="about__text reveal">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 class="section-title">{t.about.title}</h2>
      {t.about.paragraphs.map((paragraph) => <p class="about__p">{paragraph}</p>)}

      <dl class="facts">
        {
          t.about.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Original abstract visual built with CSS: layered glass panels over colour orbs. -->
    <div class="visual reveal" style="--i:1" aria-hidden="true">
      <span class="orb orb--a"></span>
      <span class="orb orb--b"></span>
      <span class="orb orb--c"></span>
      <div class="pane pane--back"></div>
      <div class="pane pane--mid">
        <span class="pane__line pane__line--wide"></span>
        <span class="pane__line"></span>
        <span class="pane__line pane__line--short"></span>
      </div>
      <div class="pane pane--front">
        <span class="pane__dot"></span>
        <span class="pane__block"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .about__text {
    display: grid;
    gap: 1.25rem;
  }

  .section-title {
    margin-bottom: 0.5rem;
  }

  .about__p {
    max-width: 36rem;
    color: #d3d3da;
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
  }

  .facts {
    display: grid;
    gap: 0;
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .facts dd {
    font-weight: 500;
  }

  .visual {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    border-radius: var(--radius-l);
    background: linear-gradient(160deg, #15121f, #0c0c12);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(6px);
    animation: float 12s ease-in-out infinite alternate;
  }

  .orb--a {
    top: 12%;
    left: 14%;
    width: 46%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 30% 30%, #b388ff, var(--violet) 55%, #3b0f8f);
  }

  .orb--b {
    right: 8%;
    bottom: 14%;
    width: 54%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 35% 30%, #ff7ae0, var(--magenta) 50%, #5b0f6b);
    animation-duration: 15s;
    animation-direction: alternate-reverse;
  }

  .orb--c {
    top: 20%;
    right: 12%;
    width: 26%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 35% 30%, #8fb0ff, var(--blue) 60%, #10237a);
    animation-duration: 10s;
  }

  @keyframes float {
    to {
      translate: 0 -4%;
    }
  }

  .pane {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.04));
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 20px 40px -20px rgba(0, 0, 0, 0.6);
  }

  .pane--back {
    top: 14%;
    left: 30%;
    width: 52%;
    height: 50%;
    rotate: 8deg;
  }

  .pane--mid {
    top: 30%;
    left: 12%;
    display: grid;
    align-content: end;
    gap: 0.6rem;
    width: 56%;
    height: 46%;
    padding: 1.25rem;
    rotate: -6deg;
  }

  .pane--front {
    right: 10%;
    bottom: 10%;
    display: grid;
    align-content: space-between;
    width: 40%;
    height: 34%;
    padding: 1rem;
    rotate: 4deg;
  }

  .pane__line {
    display: block;
    width: 60%;
    height: 0.45rem;
    border-radius: var(--pill);
    background: rgba(255, 255, 255, 0.35);
  }

  .pane__line--wide {
    width: 85%;
    height: 0.9rem;
    background: rgba(255, 255, 255, 0.6);
  }

  .pane__line--short {
    width: 38%;
  }

  .pane__dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .pane__block {
    display: block;
    height: 2.25rem;
    border-radius: var(--pill);
    background: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }

    .visual {
      max-width: 26rem;
    }
  }

  @media (max-width: 480px) {
    .facts div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
