---
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang);
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <span class="ribbon ribbon--a"></span>
    <span class="ribbon ribbon--b"></span>
    <span class="ribbon ribbon--c"></span>
  </div>

  <div class="container hero__inner">
    <p class="badge"><span class="badge__dot" aria-hidden="true"></span>{t.hero.badge}</p>
    <h1>{t.hero.title}</h1>
    <p class="hero__lead">{t.hero.lead}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#projects">{t.hero.ctaPrimary}</a>
      <a class="btn btn--ghost" href="#contact">{t.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(100svh, 56rem);
    padding-block: calc(var(--header-h) + 5rem) 5rem;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 80% at 50% 110%, rgba(47, 91, 255, 0.16), transparent 60%);
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 35%;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }

  .ribbon {
    position: absolute;
    left: -20%;
    width: 140%;
    height: 34%;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.7;
    animation: drift 22s ease-in-out infinite alternate;
  }

  .ribbon--a {
    top: 30%;
    background: linear-gradient(90deg, var(--magenta), var(--violet) 45%, transparent 85%);
    transform: rotate(-9deg);
  }

  .ribbon--b {
    top: 52%;
    background: linear-gradient(90deg, transparent 10%, #4c1d95 45%, var(--violet) 80%);
    transform: rotate(7deg);
    animation-duration: 28s;
    animation-direction: alternate-reverse;
  }

  .ribbon--c {
    top: 68%;
    height: 22%;
    background: linear-gradient(90deg, var(--blue), transparent 60%);
    opacity: 0.35;
    transform: rotate(-4deg);
    animation-duration: 34s;
  }

  @keyframes drift {
    to {
      translate: 5% -6%;
    }
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--pill);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .badge__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-ink);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  h1 {
    max-width: 17ch;
    font-size: clamp(2.75rem, 9.5vw, 6.75rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    hyphens: manual;
  }

  .hero__lead {
    max-width: 34rem;
    color: #cfcfd6;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 0.5rem;
  }

  .hero__actions .btn {
    min-width: 9.5rem;
  }
</style>
