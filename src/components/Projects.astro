---
import { useT, type Lang } from '../i18n';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section" id="projects">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.projects.eyebrow}</p>
      <h2 class="section-title">{t.projects.title}</h2>
      <p class="lead">{t.projects.lead}</p>
    </header>

    <ul class="grid">
      {
        projects.map((project, i) => {
          const demoUrl = typeof project.demoUrl === 'string' ? project.demoUrl : project.demoUrl[lang];
          return (
          <li class="card reveal" style={`--i:${i}; --hue:${project.hue}`}>
            <div
              class:list={['card__media', { 'card__media--contain': project.imageFit === 'contain' }]}
              style={project.imageBackground ? `background:${project.imageBackground}` : undefined}
            >
              {project.image ? (
                <img
                  src={project.image}
                  alt={t.projects.screenshotAlt.replace('{title}', project.title)}
                  width="1600"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="mock" aria-hidden="true">
                  <div class="mock__bar">
                    <i />
                    <i />
                    <i />
                  </div>
                  <div class="mock__body">
                    <span class="mock__line mock__line--title" />
                    <span class="mock__line" />
                    <span class="mock__line mock__line--short" />
                  </div>
                  <span class="mock__label">{t.projects.previewSoon}</span>
                </div>
              )}
            </div>

            <div class="card__body">
              <p class="card__tag">
                {project.category[lang]} · {t.projects.concept}
              </p>
              <h3>{project.title}</h3>
              <p class="card__text">{project.description[lang]}</p>
              {demoUrl ? (
                <a class="btn btn--primary" href={demoUrl} target="_blank" rel="noopener noreferrer">
                  {t.projects.view} <span aria-hidden="true">→</span>
                  <span class="sr-only">
                    : {project.title} ({t.projects.newTab})
                  </span>
                </a>
              ) : (
                <button class="btn" type="button" disabled>
                  {t.projects.soon}
                  <span class="sr-only">: {project.title}</span>
                </button>
              )}
            </div>
          </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    transition:
      border-color 0.3s,
      translate 0.4s var(--ease);
  }

  .card:hover {
    border-color: var(--line-strong);
    translate: 0 -4px;
  }

  .card__media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--surface-2);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: scale 0.6s var(--ease);
  }

  .card:hover .card__media img {
    scale: 1.03;
  }

  /* Whole screenshot, top-aligned; the frame's background fills the rest. */
  .card__media--contain img {
    object-fit: contain;
  }

  /* Placeholder preview shown until a real screenshot is added. */
  .mock {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background:
      radial-gradient(90% 90% at 85% 10%, hsl(var(--hue) 85% 58% / 0.55), transparent 60%),
      radial-gradient(80% 80% at 10% 100%, hsl(calc(var(--hue) - 40) 80% 45% / 0.45), transparent 65%),
      #101014;
  }

  .mock__bar {
    display: flex;
    gap: 0.35rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mock__bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
  }

  .mock__body {
    display: grid;
    align-content: center;
    gap: 0.6rem;
    flex: 1;
    padding: 0 1.5rem;
  }

  .mock__line {
    display: block;
    width: 62%;
    height: 0.5rem;
    border-radius: var(--pill);
    background: rgba(255, 255, 255, 0.16);
  }

  .mock__line--title {
    width: 44%;
    height: 1.1rem;
    background: rgba(255, 255, 255, 0.34);
  }

  .mock__line--short {
    width: 36%;
  }

  .mock__label {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--pill);
    background: rgba(9, 9, 11, 0.7);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    flex: 1;
    padding: 1.5rem 0.75rem 0.75rem;
  }

  .card__tag {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.75rem;
    letter-spacing: -0.03em;
  }

  .card__text {
    color: var(--muted);
    font-size: 1rem;
  }

  .card__body .btn {
    margin-top: auto;
    translate: 0 0.5rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 1020px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .card {
      flex-direction: row;
      align-items: stretch;
      gap: 0.5rem;
    }

    .card__media {
      flex: 0 0 44%;
      aspect-ratio: auto;
      min-height: 15rem;
    }

    /* Keep the frame at the screenshot-friendly ratio instead of stretching
       it to the full card height. */
    .card__media--contain {
      align-self: flex-start;
      aspect-ratio: 16 / 10;
      min-height: 0;
    }

    .card__body {
      padding: 1rem 1rem 0.75rem;
    }
  }

  @media (max-width: 640px) {
    .card {
      flex-direction: column;
    }

    .card__media {
      flex: none;
      aspect-ratio: 16 / 10;
      min-height: 0;
    }

    .card__body {
      padding: 1.25rem 0.5rem 0.5rem;
    }
  }
</style>
